{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "status_effects": [
    {
      "id": "level",
      "class_name": "@StatusEffectTrainerLevelState",
      "names": {
        "english": "Level"
      },
      "stackable_names": {
        "english": "Level {0}"
      },
      "card_tooltips": {
        "english": "Unit gains a 100% Stat Increase with each stack of Level.  Consumes EXP equal to 10 x Level, to increase Level by 1 permanently.\nSiphon: Gain shared EXP when an enemy dies on this floor."
      },
      "character_tooltips": {
        "english": "Unit gains a 100% Stat Increase with each stack of Level.  Consumes EXP equal to 10 x Level, to increase Level by 1 permanently.\nSiphon: Gain shared EXP when an enemy dies on this floor."
      },
      "replacement_texts": {
        "english": "<b>Level</b>"
      },
      "notifications": {
        "english": "Level"
      },
      "display_category": "persistent",
      "trigger_stage": "none",
      "is_stackable": true,
      "remove_when_triggered": false,
      "is_propagatable": false,
      "icon": "@TrainersLevelIcon"
    }
  ],
  "sprites": [
    {
      "id": "TrainersLevelIcon",
      "path": "textures/icons/OrcCustomMechanic.png"
    }
  ],
  "atlas_icons": [
    {
      "id": "TrainersLevelIcon",
      "path": "textures/icons/OrcCustomMechanic.png"
    }
  ]
}
