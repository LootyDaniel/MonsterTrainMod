      }
    }
  ],
  "sprites": [
    {
      "id": "TrappingGearCardSprite",
      "path": "textures/card_art/OrcMerchantChampion.png"
    },
    {
      "id": "TrappingGearEquipmentIcon",
      "path": "textures/icons/OrcCustomMechanic.png"
