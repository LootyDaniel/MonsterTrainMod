{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "TrappingGear",
      "names": {
        "english": "Trapping Gear"
      },
      "descriptions": {
        "english": "Grants <b>Deploy Trap</b> (Cooldown 1): Spawn a random Trap at the front of this floor."
      },
      "card_type": "equipment",
      "class": "@BountyClan",
      "rarity": "uncommon",
      "cost": 1,
      "targets_room": true,
      "targetless": false,
      "card_art": "@TrappingGearCardArt",
