    {
      "id": "GuildMasterPropagateMark4",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "random_from_any_room",
      "target_team": "both",
      "param_int": 99,
      "target_mode_status_effects_filter": [
        "@mark"
      ],
      "param_status_effects": [
        {
          "status": "@mark",
          "count": 4
        }
      ]
