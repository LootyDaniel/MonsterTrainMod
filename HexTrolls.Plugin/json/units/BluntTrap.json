      "path": "textures/character_art/LogTrap3.png"
    },
    {
      "id": "ConcussiveTrapCharacterSprite4",
      "path": "textures/character_art/LogTrap4.png"
    },
    {
      "id": "ConcussiveTrapCharacterSprite5",
      "path": "textures/character_art/LogTrap5.png"
    },
    {
      "id": "ConcussiveTrapCharacterSprite6",
      "path": "textures/character_art/LogTrap6.png"
    },
    {
      "id": "ConcussiveTrapCharacterSprite7",
      "path": "textures/character_art/LogTrap7.png"
    },
    {
      "id": "ConcussiveTrapCharacterSprite8",
