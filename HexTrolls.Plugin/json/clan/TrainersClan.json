{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "classes": [
    {
      "id": "TrainersClan",
      "titles": {
        "english": "Trainers"
      },
      "descriptions": {
        "english": "Train your companions and build a powerful team."
      },
      "subclass_descriptions": {
        "english": "A team of companions ready to be trained."
      },
      "icons": {
        "small": "@BasicClanSmallIcon",
        "medium": "@BasicClanMediumIcon",
        "large": "@BasicClanLargeIcon",
        "silhouette": "@BasicClanSilhouetteIcon"
      },
      "card_draft_icon": "@CardDraftIcon",
      "class_select_character_displays": [
        "@TrainersRedClassDisplayCharacterArt",
        "@TrainersBlueClassDisplayCharacterArt"
      ],
      "card_style": "@BountyClanCardFrame",
      "ui_color": {
        "r": 0.94,
        "g": 0.72,
        "b": 0.25
      },
      "ui_color_dark": {
        "r": 0.47,
        "g": 0.3,
        "b": 0.12
      },
      "ui_gradient": [
        {
          "time": 0.0,
          "color": {
            "r": 0.94,
            "g": 0.72,
            "b": 0.25
          }
        },
        {
          "time": 1.0,
          "color": {
            "r": 0.47,
            "g": 0.3,
            "b": 0.12
          }
        }
      ],
      "champions": [
        {
          "id": "TrainersRedChampion",
          "card_data": "@TrainersRedChampionCard",
          "starter_card": "@TrainersRedStarterCard",
          "upgrade_tree": [
            [
              "@TrainersRedPathI",
              "@TrainersRedPathII",
              "@TrainersRedPathIII"
            ]
          ],
          "icon": "@TrainersRedChampionIcon",
          "locked_icon": "@TrainersRedChampionLockedIcon",
          "portrait": "@TrainersRedChampionPortrait"
        },
        {
          "id": "TrainersBlueChampion",
          "card_data": "@TrainersBlueChampionCard",
          "starter_card": "@TrainersBlueStarterCard",
          "upgrade_tree": [
            [
              "@TrainersBluePathI",
              "@TrainersBluePathII",
              "@TrainersBluePathIII"
            ]
          ],
          "icon": "@TrainersBlueChampionIcon",
          "locked_icon": "@TrainersBlueChampionLockedIcon",
          "portrait": "@TrainersBlueChampionPortrait"
        }
      ],
      "starter_relics": [
        "@TrainersRosterProtocol"
      ]
    }
  ],
  "cards": [
    {
      "id": "TrainersStarterCard",
      "card_art": "@GuildMasterCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "common",
      "class": "@TrainersClan",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnTrainersStarter"
      ],
      "pools": [
        "MegaPool"
      ],
      "names": {
        "english": "Trainer's Assistant"
      },
      "initial_upgrades": [
        "@TrainersLevelBaseMarker"
      ]
    },
    {
      "id": "TrainersBannerCard",
      "card_art": "@GuildMasterCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@TrainersClan",
      "targets_room": true,
      "targetless": false,
      "pools": [
        "UnitsAllBanner",
        "@UnitsTrainersBanner"
      ],
      "effects": [
        "@SpawnTrainersBanner"
      ],
      "names": {
        "english": "Practice Recruit"
      },
      "initial_upgrades": [
        "@TrainersLevelBaseMarker"
      ]
    },
