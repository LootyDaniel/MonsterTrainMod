    {
      "id": "SpawnTrainersBanner",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@TrainersBannerCharacter",
      "param_bool": false
    },
    {
      "id": "TrainersStarterEXPOnKill",
